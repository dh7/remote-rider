#!/usr/bin/env python3
"""
rr-files — open the workspace's built-in Files viewer as a tab in the control plane.

Usage:
  rr-files [PATH]              Open PATH (default: current directory)
  rr-files --label LABEL       Custom tab label (default: "Files: <path>")
  rr-files --control URL       Control URL (overrides .rr)
  rr-files --session NAME      Session name (overrides .rr)

Reads the nearest .rr file (walks up from PATH) for control URL and session name.
PATH must live inside the project that owns that .rr file; otherwise the
project root is opened.
"""
import argparse
import json
import os
import sys
import urllib.parse
import urllib.request
from pathlib import Path


def _find_rr(start: Path):
    current = start.resolve()
    while True:
        candidate = current / ".rr"
        if candidate.exists():
            return candidate
        parent = current.parent
        if parent == current:
            return None
        current = parent


def _post(url: str, payload: dict) -> dict:
    data = json.dumps(payload).encode()
    req = urllib.request.Request(url, data=data, headers={"content-type": "application/json"}, method="POST")
    with urllib.request.urlopen(req, timeout=8) as resp:
        return json.loads(resp.read())


def files_tab_path(session_name: str, path: Path, project_root: Path | None) -> str:
    base = f"/workspaces/{urllib.parse.quote(session_name, safe='')}/files"
    if project_root is None:
        return base
    path, project_root = path.resolve(), project_root.resolve()
    if path != project_root and project_root not in path.parents:
        return base
    rel = path.relative_to(project_root).as_posix()
    return base if rel == "." else f"{base}?path={urllib.parse.quote(rel)}"


def main():
    parser = argparse.ArgumentParser(description="Open a built-in Files tab in Remote Rider.")
    parser.add_argument("path", nargs="?", default=".", help="Directory to browse (default: current)")
    parser.add_argument("--label", default=None)
    parser.add_argument("--control", default=None)
    parser.add_argument("--session", default=None)
    args = parser.parse_args()

    path = Path(args.path).resolve()
    if not path.is_dir():
        print(f"error: {path} is not a directory", file=sys.stderr)
        sys.exit(1)

    rr: dict = {}
    rr_path = _find_rr(path) or _find_rr(Path.cwd())
    if rr_path:
        try:
            rr = json.loads(rr_path.read_text())
        except Exception:
            pass

    control_url = args.control or rr.get("control") or os.environ.get("RR_CONTROL", "")
    session_name = args.session or rr.get("session") or os.environ.get("RR_SESSION", "")

    if not control_url:
        print("error: control URL not found — create a .rr file or pass --control", file=sys.stderr)
        sys.exit(1)
    if not session_name:
        print("error: session name not found — create a .rr file or pass --session", file=sys.stderr)
        sys.exit(1)

    label = args.label or f"Files: {path}"
    control_url = control_url.rstrip("/")

    project_root = rr_path.parent if rr_path else None
    tab_path = files_tab_path(session_name, path, project_root)
    if project_root and tab_path.endswith("/files") and path.resolve() != project_root.resolve():
        print(f"note: {path} is outside {project_root}; opening the project root", file=sys.stderr)

    try:
        tab_result = _post(
            f"{control_url}/sessions/{urllib.parse.quote(session_name, safe='')}/tabs",
            {"label": label, "service": "builtin", "port": 7000, "path": tab_path, "protocol": "http"},
        )
    except Exception as exc:
        print(f"error: could not register tab at control: {exc}", file=sys.stderr)
        sys.exit(1)
    print(f"Tab '{label}' {tab_result.get('action', 'registered')} in session '{session_name}' -> {tab_path}")

if __name__ == "__main__":
    main()
