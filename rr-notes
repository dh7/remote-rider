#!/usr/bin/env python3
"""
rr-notes — Remote Rider project notes/status tab.

Shows the durable agent instructions, a project TODO list, and a session handoff
status file. Missing TODO.md and STATUS.md can be created from the UI.
"""
from __future__ import annotations

import argparse
import json
import os
import socket
import subprocess
import sys
import time
import urllib.parse
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from typing import Any


FILES = {
    "agent": ["Agents.md", "AGENTS.md", "CLAUDE.md"],
    "todo": ["TODO.md"],
    "status": ["STATUS.md"],
}

DEFAULT_TODO = """# TODO

## Next
- [ ] 

## Done
- [ ] 
"""

DEFAULT_STATUS = """# Status

## Current Focus


## Last Updated


## What Changed


## Current State


## Next Steps


## Open Questions

"""

