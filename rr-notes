    function esc(s) {
      return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    }
    function inline(s) {
      return esc(s).replace(/`([^`]+)`/g, '<code>$1</code>').replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
    }
    function renderMarkdown(text) {
      const lines = String(text || '').split('\n');
      let out = '';
      let inCode = false;
      let inList = false;
      for (const line of lines) {
        if (line.startsWith('```')) {
          if (inCode) { out += '</code></pre>'; inCode = false; } else { out += '<pre><code>'; inCode = true; }
          continue;
        }
        if (inCode) { out += esc(line) + '\n'; continue; }
        const h = line.match(/^(#{1,3})\s+(.*)$/);
        if (h) {
          if (inList) { out += '</ul>'; inList = false; }
          out += `<h${h[1].length}>${inline(h[2])}</h${h[1].length}>`;
          continue;
        }
        const li = line.match(/^\s*-\s+(\[[ xX]\]\s+)?(.*)$/);
        if (li) {
          if (!inList) { out += '<ul>'; inList = true; }
          const checked = li[1] && li[1].toLowerCase().includes('x');
          const box = li[1] ? `<input type="checkbox" disabled ${checked ? 'checked' : ''}> ` : '';
          out += `<li>${box}${inline(li[2])}</li>`;
          continue;
        }
        if (inList) { out += '</ul>'; inList = false; }
        out += line.trim() ? `<p>${inline(line)}</p>` : '';
      }
      if (inList) out += '</ul>';
      if (inCode) out += '</code></pre>';
      document.getElementById('preview').innerHTML = out || '<p>Empty file.</p>';
