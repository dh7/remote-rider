def find_rr(start: Path) -> Path | None:
    current = start.resolve()
    while True:
        candidate = current / ".rr"
        if candidate.exists():
            return candidate
        if current.parent == current:
            return None
        current = current.parent


def load_rr(project: Path) -> dict[str, str]:
    rr = find_rr(project)
    if not rr:
        return {}
    try:
        data = json.loads(rr.read_text())
    except Exception:
        return {}
    return {k: str(v) for k, v in data.items() if isinstance(v, str)}


def pick_port(start: int) -> int:
    port = start
    while port < 65535:
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
            sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            try:
                sock.bind(("127.0.0.1", port))
            except OSError:
                port += 1
                continue
            return port
    raise RuntimeError("no free port found")


def file_for(project: Path, kind: str) -> Path | None:
    names = FILES.get(kind)
    if not names:
        return None
    for name in names:
        path = project / name
        if path.exists():
            return path
    if kind in {"todo", "status"}:
        return project / names[0]
    return None


def read_file(project: Path, kind: str) -> dict[str, Any]:
    path = file_for(project, kind)
    exists = bool(path and path.exists())
    return {
        "kind": kind,
        "path": str(path.relative_to(project)) if path else "",
        "exists": exists,
        "content": path.read_text(errors="replace") if exists and path else "",
    }


def default_content(kind: str) -> str:
    if kind == "todo":
        return DEFAULT_TODO
    if kind == "status":
        return DEFAULT_STATUS
    raise ValueError("only TODO.md and STATUS.md can be created")


def git_info(project: Path) -> dict[str, Any]:
    def run(args: list[str]) -> str:
        proc = subprocess.run(["git", *args], cwd=project, text=True, capture_output=True, check=False)
        return proc.stdout.strip() if proc.returncode == 0 else ""

    branch = run(["branch", "--show-current"])
    status = run(["status", "--short"])
    return {
        "branch": branch,
        "dirty_count": len([line for line in status.splitlines() if line.strip()]),
        "status": status,
    }


def post_json(url: str, payload: dict[str, Any]) -> dict[str, Any]:
    body = json.dumps(payload).encode()
    req = urllib.request.Request(url, data=body, headers={"content-type": "application/json"}, method="POST")
    with urllib.request.urlopen(req, timeout=5) as resp:
        return json.loads(resp.read().decode())


def register_tab(control: str, session: str, label: str, port: int) -> None:
    host = os.environ.get("PUBLIC_HOST", "")
    payload: dict[str, Any] = {
        "label": label,
        "service": "notes",
        "port": port,
        "path": "/",
        "protocol": "http",
        "ephemeral": True,
        "activate": True,
    }
    if host:
        payload["machine_host"] = host
    url = f"{control.rstrip('/')}/sessions/{urllib.parse.quote(session, safe='')}/tabs"
    post_json(url, payload)


def register_local_service(project: Path, session: str, label: str, port: int) -> None:
    registry = Path(__file__).resolve().parent / "service_registry.json"
    row = {
        "kind": "web",
        "name": "notes",
        "label": label,
        "port": port,
        "pid": os.getpid(),
        "path": "/",
        "protocol": "http",
        "session_name": session,
        "project": str(project),
        "started_at": int(time.time()),
    }
    try:
        rows = json.loads(registry.read_text()) if registry.exists() else []
        if not isinstance(rows, list):
            rows = []
    except Exception:
        rows = []
    rows = [r for r in rows if not (isinstance(r, dict) and r.get("pid") == os.getpid())]
    rows.append(row)
    registry.write_text(json.dumps(rows, indent=2) + "\n")


class NotesHandler(BaseHTTPRequestHandler):
    project: Path

    def log_message(self, fmt: str, *args: Any) -> None:
        return

    def _send(self, status: int, content_type: str, body: bytes) -> None:
        self.send_response(status)
        self.send_header("content-type", content_type)
        self.send_header("content-length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _json(self, status: int, data: dict[str, Any]) -> None:
        self._send(status, "application/json", (json.dumps(data, indent=2) + "\n").encode())

    def _body(self) -> dict[str, Any]:
        length = int(self.headers.get("content-length", "0") or "0")
        if length <= 0:
            return {}
        try:
            return json.loads(self.rfile.read(length).decode())
        except Exception:
            return {}

    def do_GET(self) -> None:
        if self.path == "/" or self.path.startswith("/?"):
            self._send(200, "text/html; charset=utf-8", HTML.encode())
            return
        if self.path == "/api/state":
            self._json(200, {
                "project": str(self.project),
                "files": {kind: read_file(self.project, kind) for kind in FILES},
                "git": git_info(self.project),
            })
            return
        self._json(404, {"status": "error", "error": "not found"})

    def do_POST(self) -> None:
        body = self._body()
        kind = str(body.get("kind", ""))
        try:
            if self.path == "/api/create":
                if kind not in {"todo", "status"}:
                    raise RuntimeError("only TODO.md and STATUS.md can be created")
                path = file_for(self.project, kind)
                if path is None:
                    raise RuntimeError("unknown file kind")
                if not path.exists():
                    path.write_text(default_content(kind))
                self._json(200, {"status": "ok", "file": read_file(self.project, kind)})
                return
            if self.path == "/api/save":
                if kind not in FILES:
                    raise RuntimeError("unknown file kind")
                path = file_for(self.project, kind)
                if path is None:
                    raise RuntimeError("file target not found")
                if kind == "agent" and not path.exists():
                    raise RuntimeError("agent file does not exist")
                path.write_text(str(body.get("content", "")))
                self._json(200, {"status": "ok", "file": read_file(self.project, kind)})
                return
        except Exception as exc:
            self._json(500, {"status": "error", "error": str(exc)})
            return
        self._json(404, {"status": "error", "error": "not found"})


def main() -> int:
    parser = argparse.ArgumentParser(description="Open a project notes/status tab in Remote Rider.")
    parser.add_argument("--project", default=".", help="Project directory to manage")
    parser.add_argument("--port", type=int, default=8126, help="Preferred local port")
    parser.add_argument("--label", default="Notes", help="Remote Rider tab label")
    parser.add_argument("--control", default=None, help="Control URL override")
    parser.add_argument("--session", default=None, help="Session name override")
    parser.add_argument("--no-register", action="store_true", help="Start UI without registering a Remote Rider tab")
    args = parser.parse_args()

    project = Path(args.project).expanduser().resolve()
    if not project.is_dir():
        print(f"project not found: {project}", file=sys.stderr)
        return 1

    rr = load_rr(project)
    control = args.control or rr.get("control") or os.environ.get("RR_CONTROL", "")
    session = args.session or rr.get("session") or os.environ.get("RR_SESSION", "")
    port = pick_port(args.port)

    NotesHandler.project = project
    server = ThreadingHTTPServer(("0.0.0.0", port), NotesHandler)

    if not args.no_register:
        if not control or not session:
            print("error: .rr not found or missing control/session; pass --control and --session", file=sys.stderr)
            return 1
        register_local_service(project, session, args.label, port)
        register_tab(control, session, args.label, port)
    else:
        register_local_service(project, session or "", args.label, port)

    print(f"rr-notes serving {project} on http://127.0.0.1:{port}")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        return 130
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
