#!/usr/bin/env python3
"""
rr-skill — Remote Rider tab UI for project-scoped dh7skills management.

dh7skills stays independent. This adapter owns the HTTP UI and Remote Rider tab
registration, and shells out to the canonical `dh7skill` CLI for all mutations.
"""
from __future__ import annotations

import argparse
import json
import os
import shutil
import socket
import subprocess
import sys
import urllib.parse
import urllib.request
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from typing import Any


