def find_rr(start: Path) -> Path | None:
    current = start.resolve()
    while True:
        candidate = current / ".rr"
        if candidate.exists():
            return candidate
        if current.parent == current:
            return None
        current = current.parent


def load_rr(project: Path) -> dict[str, str]:
    rr = find_rr(project)
    if not rr:
        return {}
    try:
        data = json.loads(rr.read_text())
    except Exception:
        return {}
    return {k: str(v) for k, v in data.items() if isinstance(v, str)}


def pick_port(start: int) -> int:
    port = start
    while port < 65535:
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
            sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            try:
                sock.bind(("0.0.0.0", port))
            except OSError:
                port += 1
                continue
            return port
    raise RuntimeError("no free port found")


def find_dh7skill() -> str:
    direct = shutil.which("dh7skill")
    if direct:
        return direct
    home = os.environ.get("DH7SKILLS_HOME")
    if home and (Path(home) / "bin" / "dh7skill").exists():
        return str(Path(home) / "bin" / "dh7skill")
    fallback = Path.home() / "code" / "dh7skills" / "bin" / "dh7skill"
    if fallback.exists():
        return str(fallback)
    raise RuntimeError("dh7skill not found. Run ~/code/dh7skills/install.sh --shell-integration")


def run_json(cmd: list[str], passphrase: str = "") -> dict[str, Any]:
    env = os.environ.copy()
    if passphrase:
        env["ENV_ENC_PASS"] = passphrase
    proc = subprocess.run(cmd, text=True, capture_output=True, check=False, env=env)
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr.strip() or proc.stdout.strip() or f"command failed: {' '.join(cmd)}")
    try:
        return json.loads(proc.stdout)
    except Exception as exc:
        raise RuntimeError(f"invalid JSON from {' '.join(cmd)}: {proc.stdout[:500]}") from exc


class SkillHandler(BaseHTTPRequestHandler):
    project: Path
    dh7skill: str

    def log_message(self, fmt: str, *args: Any) -> None:
        return

    def _send(self, status: int, content_type: str, body: bytes) -> None:
        self.send_response(status)
        self.send_header("content-type", content_type)
        self.send_header("content-length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _json(self, status: int, data: dict[str, Any]) -> None:
        self._send(status, "application/json", (json.dumps(data, indent=2) + "\n").encode())

    def _body(self) -> dict[str, Any]:
        length = int(self.headers.get("content-length", "0") or "0")
        if length <= 0:
            return {}
        try:
            return json.loads(self.rfile.read(length).decode())
        except Exception:
            return {}

    def do_GET(self) -> None:
        if self.path == "/" or self.path.startswith("/?"):
            self._send(200, "text/html; charset=utf-8", HTML.encode())
            return
        if self.path == "/api/state":
            try:
                self._json(200, {
                    "project": str(self.project),
                    "skills": run_json([self.dh7skill, "list", "--json"]),
                    "external_skills": run_json([self.dh7skill, "external-list", "--project", str(self.project), "--json"]),
                    "installed": run_json([self.dh7skill, "installed", "--project", str(self.project), "--json"]),
                    "env": run_json([self.dh7skill, "check-env", "--project", str(self.project), "--json"]),
                })
            except Exception as exc:
                self._json(500, {"status": "error", "error": str(exc)})
            return
        self._json(404, {"status": "error", "error": "not found"})

    def do_POST(self) -> None:
        body = self._body()
        name = str(body.get("name", "")).strip()
        passphrase = str(body.get("passphrase", ""))
        try:
            if self.path == "/api/add":
                if not name:
                    raise RuntimeError("name is required")
                self._json(200, run_json([self.dh7skill, "add", name, "--project", str(self.project), "--json"], passphrase))
                return
            if self.path == "/api/add-external":
                repo = str(body.get("repo", "")).strip()
                if not repo or not name:
                    raise RuntimeError("repo and name are required")
                self._json(200, run_json([self.dh7skill, "add-external", repo, "--skill", name, "--project", str(self.project), "--json"]))
                return
            if self.path == "/api/remove":
                if not name:
                    raise RuntimeError("name is required")
                self._json(200, run_json([self.dh7skill, "remove", name, "--project", str(self.project), "--json"], passphrase))
                return
            if self.path == "/api/sync":
                self._json(200, run_json([self.dh7skill, "sync", "--project", str(self.project), "--json"], passphrase))
                return
        except Exception as exc:
            self._json(500, {"status": "error", "error": str(exc)})
            return
        self._json(404, {"status": "error", "error": "not found"})


def post_json(url: str, payload: dict[str, Any]) -> dict[str, Any]:
    body = json.dumps(payload).encode()
    req = urllib.request.Request(url, data=body, headers={"content-type": "application/json"}, method="POST")
    with urllib.request.urlopen(req, timeout=5) as resp:
        return json.loads(resp.read().decode())


def service_name_for_session(session: str) -> str:
    cleaned = "".join(ch.lower() if ch.isalnum() else "-" for ch in session.strip())
    collapsed = "-".join(part for part in cleaned.split("-") if part)
    return f"skills-{collapsed or 'session'}"


def register_tab(control: str, session: str, label: str, port: int) -> None:
    host = os.environ.get("PUBLIC_HOST", "")
    service_name = service_name_for_session(session)
    payload: dict[str, Any] = {
        "label": label,
        "service": service_name,
        "port": port,
        "path": "/",
        "protocol": "http",
        "ephemeral": True,
        "activate": True,
    }
    if host:
        payload["machine_host"] = host
    url = f"{control.rstrip('/')}/sessions/{urllib.parse.quote(session, safe='')}/tabs"
    post_json(url, payload)


def register_local_service(project: Path, session: str, label: str, port: int) -> None:
    registry = Path(__file__).resolve().parent / "service_registry.json"
    service_name = service_name_for_session(session)
    row = {
        "kind": "web",
        "name": service_name,
        "label": label,
        "port": port,
        "pid": os.getpid(),
        "path": "/",
        "protocol": "http",
        "session_name": session,
        "project": str(project),
        "started_at": int(time.time()),
    }
    try:
        rows = json.loads(registry.read_text()) if registry.exists() else []
        if not isinstance(rows, list):
            rows = []
    except Exception:
        rows = []
    rows = [
        r for r in rows
        if not (
            isinstance(r, dict)
            and (
                r.get("pid") == os.getpid()
                or (r.get("name") == service_name and r.get("session_name") == session)
                or (r.get("name") == "skills" and r.get("session_name") == session)
            )
        )
    ]
    rows.append(row)
    registry.write_text(json.dumps(rows, indent=2) + "\n")


def main() -> int:
    parser = argparse.ArgumentParser(description="Open a dh7skills manager tab in Remote Rider.")
    parser.add_argument("--project", default=".", help="Project directory to manage")
    parser.add_argument("--port", type=int, default=8127, help="Preferred local port")
    parser.add_argument("--label", default="Skills", help="Remote Rider tab label")
    parser.add_argument("--control", default=None, help="Control URL override")
    parser.add_argument("--session", default=None, help="Session name override")
    parser.add_argument("--no-register", action="store_true", help="Start UI without registering a Remote Rider tab")
    args = parser.parse_args()

    project = Path(args.project).expanduser().resolve()
    if not project.is_dir():
        print(f"project not found: {project}", file=sys.stderr)
        return 1

    rr = load_rr(project)
    control = args.control or rr.get("control") or os.environ.get("RR_CONTROL", "")
    session = args.session or rr.get("session") or os.environ.get("RR_SESSION", "")
    port = pick_port(args.port)
    dh7skill = find_dh7skill()

    SkillHandler.project = project
    SkillHandler.dh7skill = dh7skill
    server = ThreadingHTTPServer(("0.0.0.0", port), SkillHandler)

    if not args.no_register:
        if not control or not session:
            print("error: .rr not found or missing control/session; pass --control and --session", file=sys.stderr)
            return 1
        register_local_service(project, session, args.label, port)
        register_tab(control, session, args.label, port)
    else:
        register_local_service(project, session or "", args.label, port)

    print(f"rr-skill serving {project} on http://127.0.0.1:{port}")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        return 130
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
